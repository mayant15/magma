Bootstrap: localimage
From: arc/package/base.sif

%arguments
  fuzzer=aflplusplus
  target=libpng
  isan=1
  harden=1
  canaries=1
  fixes=
  build_flags=

%files
  ./targets/{{ target }} /magma/targets/{{ target }}

%post -c /bin/bash
  set -e

  export MAGMA_R=/magma
  export MAGMA=/magma/magma
  export SHARED=/magma_shared
  export OUT=/magma_out
  export FUZZER=/magma/fuzzers/{{ fuzzer }}
  export TARGET=/magma/targets/{{ target }}

  export CC=/usr/bin/gcc
  export CXX=/usr/bin/g++
  export LD=/usr/bin/ld
  export AR=/usr/bin/ar
  export AS=/usr/bin/as
  export NM=/usr/bin/nm
  export RANLIB=/usr/bin/ranlib

  if [[ ! -d "$FUZZER" ]]; then
    echo "incompatible build arg fuzzer: " {{ fuzzer }}
    exit 1
  fi

  $TARGET/preinstall.sh
  $TARGET/fetch.sh
  $MAGMA/apply_patches.sh

  ISAN_FLAG=""
  if [[ -n '{{ isan }}' ]]; then
    ISAN_FLAG="-DMAGMA_FATAL_CANARIES"
  fi

  HARDEN_FLAG=
  if [[ -n '{{ harden }}' ]]; then
    HARDEN_FLAG="-DMAGMA_HARDEN_CANARIES"
  fi

  CANARIES_FLAG=
  if [[ -n '{{ canaries }}' ]]; then
    CANARIES_FLAG="-DMAGMA_ENABLE_CANARIES"
  fi

  FIXES_FLAG=
  if [[ -n '{{ fixes }}' ]]; then
    FIXES_FLAG="-DMAGMA_ENABLE_FIXES"
  fi

  BUILD_FLAGS='{{ build_flags }}'
  if [[ -z $BUILD_FLAGS ]]; then
    BUILD_FLAGS="-include $MAGMA/src/canary.h $CANARIES_FLAG $FIXES_FLAG $ISAN_FLAG $HARDEN_FLAG -g -O0"
  fi

  export CFLAGS="$BUILD_FLAGS"
  export CXXFLAGS="$BUILD_FLAGS"
  export LIBS='-l:magma.o -lrt'
  export LDFLAGS="-L$OUT -g"

  {
    printf 'export CFLAGS=%q\n' "$CFLAGS"
    printf 'export CXXFLAGS=%q\n' "$CXXFLAGS"
    printf 'export LIBS=%q\n' "$LIBS"
    printf 'export LDFLAGS=%q\n' "$LDFLAGS"
  } >> $APPTAINER_ENVIRONMENT

  $FUZZER/instrument.sh

%environment
  export MAGMA_R=/magma
  export MAGMA=/magma/magma
  export SHARED=/magma_shared
  export OUT=/magma_out
  export FUZZER=/magma/fuzzers/{{ fuzzer }}
  export TARGET=/magma/targets/{{ target }}

%runscript
  exec $MAGMA/run.sh "$@"
